---
interface Props {
  tilt?: number;
  tone?: 'white' | 'accent' | 'ink';
  class?: string;
}
const { tilt = 0, tone = 'white', class: className = '' } = Astro.props;
---
<div class:list={['sticker', `sticker--${tone}`, className]} style={`--tilt:${tilt}deg`}>
  <slot />
</div>

<style>
  .sticker {
    border: var(--border);
    box-shadow: var(--shadow);
    padding: 1rem 1.25rem;
    transform: rotate(var(--tilt));
    transition: transform .35s var(--ease-spring), box-shadow .35s var(--ease-spring);
  }
  .sticker--white { background: var(--white); }
  .sticker--accent { background: var(--accent); }
  .sticker--ink { background: var(--ink); color: var(--accent); }
</style>
