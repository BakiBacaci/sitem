---
import { archive } from '../data/archive';
---
<div class="archive">
  <h3 class="archive__title">Arşiv</h3>
  <ul>
    {archive.map((a) => (
      <li>
        {a.href
          ? <a href={a.href} target="_blank" rel="noopener"><span class="t">{a.title}</span><span class="k">{a.kind}</span><span class="g" aria-hidden="true">↗</span></a>
          : <div><span class="t">{a.title}</span><span class="k">{a.kind}</span><span class="g" aria-hidden="true">·</span></div>}
      </li>
    ))}
  </ul>
</div>

<style>
  .archive { margin-top: clamp(64px, 8vw, 110px); }
  .archive__title { font-size: 1.4rem; margin-bottom: 14px; }
  ul { list-style: none; padding: 0; margin: 0; border-top: var(--border); }
  li > * {
    display: grid; grid-template-columns: 1fr auto 2ch; gap: 16px; align-items: baseline;
    padding: 14px 6px; border-bottom: var(--border); text-decoration: none;
    transition: background .2s, padding .3s var(--ease-spring);
  }
  li > a:hover { background: var(--accent); padding-left: 18px; }
  .t { font: 900 clamp(1.1rem, 2.4vw, 1.6rem)/1.1 var(--font-display); text-transform: uppercase; }
  .k { font-size: .85rem; }
  .g { font-weight: 800; text-align: right; }
  @media (max-width: 600px) { li > * { grid-template-columns: 1fr 2ch; } .k { grid-column: 1; grid-row: 2; } }
</style>
