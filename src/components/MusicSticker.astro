---
// Arka plan şarkısı: Spotify'ın resmi oynatıcısı. Şarkı dosyası sitede barındırılmaz (telif);
// oynatıcı da ziyaretçi tıklayana kadar yüklenmez (hız + üçüncü taraf çerezleri).
const TRACK_ID = '5bvxbR8NGYTJIZqBfqZvPt'; // Tame Impala — Borderline (The Slow Rush)
const TITLE = 'Borderline';
const ARTIST = 'Tame Impala';
---
<div class="music" data-music data-track={TRACK_ID} transition:persist>
  <button type="button" class="music__btn" aria-expanded="false" aria-controls="music-player" aria-label={`Müzik: ${TITLE}, ${ARTIST}`}>
    <span class="music__disc" aria-hidden="true">♫</span>
    <span class="music__text"><b>{TITLE}</b> · {ARTIST}</span>
  </button>
  <div id="music-player" class="music__player" hidden></div>
</div>

<style>
  .music { position: fixed; left: 16px; bottom: 16px; z-index: 45; display: grid; gap: 8px; justify-items: start; }
  .music__btn {
    display: flex; align-items: center; gap: 8px; cursor: pointer;
    background: var(--white); border: var(--border); box-shadow: 4px 4px 0 var(--ink);
    padding: 6px 12px 6px 6px; font: 700 12px var(--font-mono); color: var(--ink); rotate: -2deg;
    transition: rotate .3s var(--ease-spring), transform .3s var(--ease-spring);
  }
  .music__btn:hover { rotate: 0deg; transform: translateY(-3px); }
  .music__disc {
    width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--accent); font-size: 14px;
  }
  .music[data-playing] .music__disc { animation: spin 3s linear infinite; }
  .music__player { width: min(320px, calc(100vw - 32px)); border: var(--border); box-shadow: 4px 4px 0 var(--ink); background: var(--ink); }
  .music__player :global(iframe) { display: block; width: 100%; height: 80px; border: 0; }
  @keyframes spin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .music[data-playing] .music__disc { animation: none; } }
  @media (max-width: 767px) { .music__text { display: none; } .music__btn { padding: 6px; } }
</style>

<script>
  function bindMusic() {
    const root = document.querySelector<HTMLElement>('[data-music]');
    const btn = root?.querySelector<HTMLButtonElement>('.music__btn');
    const player = root?.querySelector<HTMLElement>('.music__player');
    if (!root || !btn || !player || root.dataset.musicBound) return;
    root.dataset.musicBound = '1';
    btn.addEventListener('click', () => {
      if (!player.firstChild) {
        const f = document.createElement('iframe');
        f.src = `https://open.spotify.com/embed/track/${root.dataset.track}?utm_source=generator&theme=0`;
        f.title = 'Spotify oynatıcısı: Tame Impala — Borderline';
        f.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
        f.loading = 'lazy';
        player.appendChild(f);
        root.dataset.playing = '';
      }
      const open = player.hidden;
      player.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    });
  }
  document.addEventListener('astro:page-load', bindMusic);
</script>
