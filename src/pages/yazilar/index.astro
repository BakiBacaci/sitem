---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts } from '../../lib/posts';

const posts = await publishedPosts();
---
<BaseLayout title="Yazılar — Baki Bacacı" description="Projelerin arka planı ve yolda öğrendiklerim.">
  <main class="list">
    <a class="list__back" href="/#yazilar">← Ana sayfa</a>
    <h1>Yazılar<span class="dot">.</span></h1>
    <p class="list__lead">Projelerin arka planı, yolda öğrendiklerim ve aklıma takılanlar.</p>
    <div class="list__grid">{posts.map((p, i) => <PostCard post={p} index={i} />)}</div>
  </main>
</BaseLayout>

<style>
  .list { padding: 110px var(--gutter) 120px; max-width: 1200px; margin: 0 auto; }
  .list__back { display: inline-block; font-weight: 800; text-decoration: none; border: var(--border); padding: .35em .8em; background: var(--white); box-shadow: 4px 4px 0 var(--ink); }
  h1 { font-size: clamp(3rem, 12vw, 9rem); margin-top: 48px; }
  .dot { color: var(--accent); }
  .list__lead { font-size: 1.2rem; font-weight: 700; margin: 12px 0 56px; }
  .list__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 32px; }
</style>
