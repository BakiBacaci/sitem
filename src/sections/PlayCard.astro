---
import Section from '../components/Section.astro';
---
<Section id="oyun-alani" kicker="05" title="Oyun<br />Alanı" tone="ink">
  <p class="play__lead">Sitenin içinde bir bilgisayar daha var. Mini oyunlar, bir terminal ve birkaç gizli şey seni bekliyor.</p>
  <a class="play" href="/oyun" data-play-card data-cursor-hover>
    <div class="play__screen">
      <div class="play__scan" aria-hidden="true"></div>
      <div class="play__icons" aria-hidden="true"><span>🐍</span><span>⌨️</span><span>🟢</span><span>🃏</span><span>📄</span></div>
      <p class="play__cta">OYUN ALANINA GİR →</p>
      <p class="play__boot" aria-hidden="true">BAKİ OS yükleniyor<span>...</span></p>
    </div>
    <div class="play__stand" aria-hidden="true"></div>
  </a>
</Section>

<style>
  .play__lead { max-width: 52ch; font-size: 1.1rem; margin: 0 0 40px; }
  .play { display: block; text-decoration: none; max-width: 900px; margin: 0 auto; color: var(--ink); }
  .play__screen {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    background: var(--paper) radial-gradient(rgba(11, 11, 11, .14) 1.5px, transparent 1.5px) 0 0 / 16px 16px;
    border: 10px solid var(--paper); outline: var(--border); box-shadow: 14px 14px 0 var(--accent);
    display: grid; place-content: center; justify-items: center; gap: 28px;
    transition: transform .4s var(--ease-spring);
  }
  .play:hover .play__screen { transform: rotate(-1deg) scale(1.02); }
  .play__icons { display: flex; gap: 14px; }
  .play__icons span { width: 58px; height: 58px; display: grid; place-items: center; font-size: 26px; background: var(--white); border: var(--border); box-shadow: 4px 4px 0 var(--ink); transition: transform .4s var(--ease-spring); }
  .play:hover .play__icons span { transform: translateY(-8px) rotate(-6deg); }
  .play:hover .play__icons span:nth-child(even) { transform: translateY(-4px) rotate(6deg); }
  .play__cta { font: 900 clamp(1.2rem, 3.6vw, 2.4rem)/1 var(--font-display); background: var(--accent); padding: .3em .5em; border: var(--border); margin: 0; }
  .play__stand { width: 30%; height: 26px; margin: 0 auto; background: var(--paper); border: var(--border); border-top: 0; }
  .play__scan { position: absolute; inset: 0; background: linear-gradient(transparent 48%, rgba(255, 90, 31, .18) 50%, transparent 52%); background-size: 100% 12px; pointer-events: none; opacity: .5; }
  .play__boot { position: absolute; inset: 0; margin: 0; display: none; place-items: center; background: var(--ink); color: var(--accent); font: 800 1.4rem var(--font-mono); }
  .play.booting .play__boot { display: grid; animation: flicker .9s steps(6) forwards; }
  .play__boot span { animation: dots .9s steps(4) infinite; display: inline-block; width: 3ch; overflow: hidden; vertical-align: bottom; }
  @keyframes flicker { 0% { opacity: 0; } 20% { opacity: 1; } 30% { opacity: .4; } 40%, 100% { opacity: 1; } }
  @keyframes dots { from { width: 0; } to { width: 3ch; } }
  @media (max-width: 600px) { .play__icons span { width: 40px; height: 40px; font-size: 18px; } }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { prefersReducedMotion } from '../lib/motion';

  document.addEventListener('astro:page-load', () => {
    const card = document.querySelector<HTMLAnchorElement>('[data-play-card]');
    if (!card || card.dataset.playBound) return;
    card.dataset.playBound = '1';
    card.addEventListener('click', (e) => {
      if (prefersReducedMotion() || e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      card.classList.add('booting');
      setTimeout(() => { void navigate('/oyun'); }, 900);
    });
  });
</script>
